DATABASE_URL=mysql://root@127.0.0.1:3306/refberg_sylius_tpay_plugin_%kernel.environment%?serverVersion=8.0

SYLIUS_TEST_APP_BUNDLES_PATH="tests/TestApplication/config/bundles.php"
SYLIUS_TEST_APP_CONFIGS_TO_IMPORT="@RefbergSyliusTpayPlugin/tests/TestApplication/config/config.yaml;@RefbergSyliusTpayPlugin/tests/TestApplication/config/webpack_encore.yaml"
SYLIUS_TEST_APP_ROUTES_TO_IMPORT="@RefbergSyliusTpayPlugin/tests/TestApplication/config/routes.yaml"

SYLIUS_MESSENGER_TRANSPORT_PAYMENT_REQUEST_DSN=sync://
SYLIUS_MESSENGER_TRANSPORT_PAYMENT_REQUEST_FAILED_DSN=sync://

# Committed test-only key: it encrypts nothing but test data and must never be used in production.
SYLIUS_PAYMENT_ENCRYPTION_KEY_PATH=%kernel.project_dir%/../../../tests/TestApplication/config/encryption/test-only.key
