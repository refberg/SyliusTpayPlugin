{
    "name": "refberg/sylius-tpay-plugin",
    "description": "Tpay OpenAPI payment gateway for Sylius 2, built on Payment Requests (no Payum).",
    "license": "MIT",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "tpay",
        "payment",
        "payment-request"
    ],
    "authors": [
        {
            "name": "Refberg"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-filter": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "doctrine/dbal": "^3.10 || ^4.0",
        "doctrine/orm": "^2.20 || ^3.3",
        "psr/log": "^3.0",
        "sylius/resource-bundle": "^1.12",
        "sylius/sylius": "~2.2.12 || ^2.3.2",
        "symfony/cache-contracts": "^3.5",
        "symfony/config": "^6.4 || ^7.4 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.0",
        "symfony/form": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-client-contracts": "^3.4",
        "symfony/http-foundation": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.0",
        "symfony/routing": "^6.4 || ^7.4 || ^8.0",
        "symfony/validator": "^6.4 || ^7.4 || ^8.0",
        "symfony/workflow": "^6.4 || ^7.4 || ^8.0"
    },
    "require-dev": {
        "doctrine/data-fixtures": "^1.8 || ^2.0",
        "doctrine/persistence": "^3.4 || ^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.4",
        "rector/rector": "^2.8",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "sylius-labs/coding-standard": "^4.4",
        "sylius/test-application": "^2.2.0@alpha || ^2.3.0@alpha",
        "sylius/twig-hooks": "^0.9 || ^0.12 || ^0.14",
        "symfony/browser-kit": "^6.4 || ^7.4 || ^8.0",
        "symfony/cache": "^6.4 || ^7.4 || ^8.0",
        "symfony/debug-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/dom-crawler": "^6.4 || ^7.4 || ^8.0",
        "symfony/dotenv": "^6.4 || ^7.4 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/intl": "^6.4 || ^7.4 || ^8.0",
        "symfony/process": "^6.4 || ^7.4 || ^8.0",
        "symfony/runtime": "^6.4 || ^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/webpack-encore-bundle": "^2.2"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Refberg\\SyliusTpayPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Refberg\\SyliusTpayPlugin\\": [
                "tests/",
                "tests/TestApplication/src/"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        },
        "public-dir": "vendor/sylius/test-application/public"
    },
    "scripts": {
        "database-reset": [
            "vendor/bin/console doctrine:database:drop --force --if-exists",
            "vendor/bin/console doctrine:database:create",
            "vendor/bin/console doctrine:migrations:migrate -n"
        ],
        "test-app-init": [
            "@database-reset"
        ]
    }
}
